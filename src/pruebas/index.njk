  - { when: "2022–2024", title: "CFGS ASIR", where: "IES Severo Ochoa · Elche", note: "Sistemas, redes y servicios." }
  - { when: "2025–2026", title: "Especialización en Administración Cloud", where: "IES Poeta Paco Mollá · Petrer", note: "Centrada en AWS." }
  - { when: "2025–2026", title: "Máster en Inteligencia Artificial", where: "BIG school · Universidad Isabel I", note: "Doble titulación, con el Diploma de Experto Universitario en IA." }
  - { when: "En curso", title: "AI Engineering", where: "Formación autodidacta", note: "Agentes, RAG y APIs, siguiendo la hoja de ruta de /ia/." }
badges:
  - { tag: "AWS", text: "AWS Academy Cloud Security Builder (Trained)" }
  - { tag: "LAB", text: "+40 laboratorios de AWS Skill Builder" }
  - { tag: "SEC", text: "5 cursos de Academia de Hackers (2025)" }
  - { tag: "PY", text: "Python Essentials 1 y 2 · Cisco" }
