{#- Componentes reutilizables. Uso: {% from "macros.njk" import facetDivider, affiliateDisclosure, reviewsBlock, picture, jamMilestone %}
     La tarjeta de producto es el shortcode {% product "id" %} (eleventy.config.js). -#}

{#- Separador entre secciones con las facetas del logo. align: start | center | end -#}
{% macro facetDivider(align="center", tone="azure") %}
<div class="facet-divider facet-divider--{{ align }} facet-divider--{{ tone }}" aria-hidden="true" data-reveal>
  <svg class="facet-divider__shape" viewBox="0 0 240 48" width="240" height="48" focusable="false">
    <path class="facet-divider__fill facet-divider__fill--a" d="M40 40 L92 6 L120 40 Z"/>
    <path class="facet-divider__fill facet-divider__fill--b" d="M120 40 L148 20 L176 40 Z"/>
    <path class="facet-divider__fill facet-divider__fill--c" d="M92 6 L132 6 L120 40 Z"/>
    <path class="facet-divider__stroke" d="M40 40 L92 6 H132 L120 40 L148 20 L176 40" pathLength="1"/>
    <path class="facet-divider__route" d="M0 40 H40 L92 6 H132 L120 40 L148 20 L176 40 H240"/>
    <path class="facet-divider__spark" d="M92 0 L93.6 4.4 L98 6 L93.6 7.6 L92 12 L90.4 7.6 L86 6 L90.4 4.4 Z"/>
  </svg>
</div>
{% endmacro %}

{#- Aviso de afiliación: el texto de Amazon es obligatorio en cada página con enlaces. -#}
{% macro affiliateDisclosure(site) %}
<aside class="disclosure" aria-label="Aviso de afiliación">
  <p class="disclosure__title mono">Transparencia</p>
  <p>En calidad de Afiliado de Amazon, obtengo ingresos por las compras adscritas que cumplen los requisitos aplicables.{% if site.affiliate.pccomponentesActive %} También participo en el programa de afiliados de PcComponentes.{% endif %}</p>
  <p>Si compras desde un enlace marcado, recibo una pequeña comisión sin que pagues más. La comisión no decide qué recomiendo: <a href="/guias/transparencia/">así elijo los productos</a>.</p>
</aside>
{% endmacro %}

{#- Reseñas de Google: solo se muestra cuando el enlace está configurado en site.js -#}
{% macro reviewsBlock(site, variant="page") %}
{%- if not site.isCommercial %}
{#- Modo portfolio: sin reseñas -#}
{%- elif site.googleReviewsUrl | isSet %}
<section class="reviews reviews--{{ variant }}" aria-labelledby="reviews-title">
  <div class="reviews__inner">
    <h2 class="reviews__title" id="reviews-title">Lo que dicen quienes ya han confiado en mí</h2>
    <p>Las opiniones están en mi ficha de Google, escritas por clientes reales.</p>
    <a class="btn btn--ghost" href="{{ site.googleReviewsUrl }}" rel="noopener" target="_blank">Ver reseñas en Google ↗</a>
  </div>
</section>
{%- else %}
<!-- Bloque de reseñas preparado: se mostrará al configurar googleReviewsUrl en src/_data/site.js -->
{%- endif %}
{% endmacro %}

{#- Imagen optimizada de src/assets/img: AVIF, WebP y JPG a los anchos de "ws" (lista). Las dimensiones son las de la versión más grande.
     Uso: {{ picture("aws-jam-equipo", [640, 1280], 1280, 853, "Descripción", "(min-width: 960px) 50vw, 100vw") }} -#}
{% macro picture(name, ws, width, height, alt, sizes, eager=false) %}
<picture>
  <source type="image/avif" srcset="{% for w in ws %}/assets/img/{{ name }}-{{ w }}.avif {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">
  <source type="image/webp" srcset="{% for w in ws %}/assets/img/{{ name }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">
  <img src="/assets/img/{{ name }}-{{ ws | last }}.jpg" srcset="{% for w in ws %}/assets/img/{{ name }}-{{ w }}.jpg {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}" width="{{ width }}" height="{{ height }}" alt="{{ alt }}"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
</picture>
{% endmacro %}

{#- Hito: 2.º puesto en la Final Nacional AWS JAM 2026, en una banda a todo el ancho. Solo se muestra en Sobre mí -#}
{% macro jamMilestone() %}
<section class="jamA" aria-labelledby="jam-title">
  <div class="wrap jamA__inner">
    <span class="jam-num" aria-hidden="true">2.º</span>
    <div class="jamA__copy">
      <p class="kicker mono">Hito destacado · 19 de junio de 2026</p>
      <h2 class="jam-title" id="jam-title"><span class="visually-hidden">2.º puesto en la </span>Final Nacional AWS JAM 2026</h2>
      <p>Segundos de España con el equipo <strong>S3-less</strong>, dentro del programa Alianza Tech de AWS, en Barcelona: retos prácticos de seguridad, automatización, infraestructura, optimización de costes y troubleshooting, todo contra reloj.</p>
      <p class="jam-links"><a class="text-link" href="https://builder.aws.com/content/3FGBmpVxiayeuR9USgA9QIfWapV/final-del-campeonato-nacional-aws-jam-2026-de-espana-pon-a-prueba-tus-habilidades-cloud" rel="noopener" target="_blank">Publicación oficial de AWS ↗</a> <a class="text-link" href="https://www.linkedin.com/feed/update/urn:li:activity:7482830026070204416/" rel="noopener" target="_blank">Mi publicación en LinkedIn ↗</a></p>
    </div>
    <div class="jamA__photos">
      <figure class="facet-frame">
        {{ picture("aws-jam-equipo", [640, 1280], 1280, 853, "El equipo S3-less, cuatro integrantes con acreditación, posa junto a la pantalla de AWS JAM 2026 en el Institut TIC de Barcelona", "(min-width: 960px) 520px, 92vw") }}
      </figure>
      <figure class="facet-frame">
        {{ picture("aws-jam-retos", [640, 1280], 1280, 853, "Los cuatro integrantes del equipo trabajando juntos en un portátil durante los retos de la final", "(min-width: 960px) 420px, 92vw") }}
      </figure>
    </div>
  </div>
</section>
{% endmacro %}

{#- Pregunta frecuente (details). i = { id, q, a, help?, link? }; cat = tema (para el filtro). La animación la pone main.js.
     help (slug de servicio) añade «¿No se resuelve? Cuéntamelo» al cuestionario con ese tema y el origen faq-<id>. -#}
{% macro faqItem(i, cat) %}
<details{% if cat %} data-cat="{{ cat }}"{% endif %}>
  <summary><span class="faq__q">{{ i.q }}</span></summary>
  <div class="faq__a"><div>
    <p>{{ i.a }}</p>
    {%- if i.link %}
    <p class="faq__cta"><a class="text-link" href="{{ i.link.url }}">{{ i.link.label }} →</a></p>
    {%- endif %}
    {%- if i.help %}
    <p class="faq__cta">¿No se resuelve? <a class="text-link" href="/contacto/?servicio={{ i.help }}&amp;origen=faq-{{ i.id }}">Cuéntamelo →</a></p>
    {%- endif %}
  </div></div>
</details>
{% endmacro %}

{#- Sección de preguntas frecuentes de una página: items = lista plana. id evita duplicar ids entre secciones. -#}
{% macro faqSection(items, lead="") %}
<section class="section faq-section" aria-labelledby="faq-title">
  <div class="wrap">
    <h2 class="section-title" id="faq-title">Preguntas frecuentes</h2>
    {%- if lead %}<p class="lead-text">{{ lead }}</p>{% endif %}
    <div class="faq faq--wide" data-faq>
      {%- for i in items %}{{ faqItem(i) }}{% endfor %}
    </div>
  </div>
</section>
{% endmacro %}

{#- Invitación breve a escribirme al final de una sección (sin saturar): texto + botón con origen y tema opcional -#}
{% macro ctaLine(text, label, origin, topic="") %}
<p class="cta-line">{{ text }} <a class="btn btn--ghost btn--sm" href="/contacto/?{% if topic %}servicio={{ topic }}&amp;{% endif %}origen={{ origin }}" data-magnetic>{{ label }}</a></p>
{% endmacro %}
