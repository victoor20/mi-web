<!doctype html>
<html lang="{{ site.lang }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {%- set canonical = (canonicalUrl or page.url) | absoluteUrl(site.url) %}
  <link rel="canonical" href="{{ canonical }}">
  {%- if noindex %}
  <meta name="robots" content="noindex, follow">
  {%- endif %}
  <meta name="theme-color" content="#03060C">
  <meta name="color-scheme" content="dark">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">

  {%- if pccVerification %}
  <meta name="verification" content="{{ site.affiliate.pccomponentesVerification }}">
  {%- endif %}

  <link rel="icon" href="/assets/img/icon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

  <link rel="preload" href="/assets/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <script>document.documentElement.classList.replace('no-js', 'js');</script>
  <style>{{ "src/assets/css/critical.css" | inlineFile | safe }}</style>
  <link rel="preload" href="/assets/css/site.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/assets/css/site.css"></noscript>
  {%- if schema and schemaData[schema] %}
  <script type="application/ld+json">{{ schemaData[schema] | json | safe }}</script>
  {%- endif %}
  {%- if jsonld %}
  <script type="application/ld+json">{{ jsonld | json | safe }}</script>
  {%- endif %}
  {%- for src in headScripts %}
  <script src="{{ src }}" async defer></script>
  {%- endfor %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  {% include "partials/header.njk" %}
  <main id="contenido" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {%- if not hideMobileCta %}
  {% include "partials/mobile-cta.njk" %}
  {%- endif %}
  <script src="/assets/js/main.js" type="module"></script>
</body>
</html>
