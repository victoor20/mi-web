{#- Logo VR en versión holograma ligera (SVG + CSS, sin Three.js). Uso: {% from "partials/logo-holo.njk" import logoHolo %}
    {{ logoHolo("lh-1", "sm") }}  → size: sm | md | lg; intro: "" | "draw" (se materializa: contorno y relleno de luz) | "recv" (destello y anillo de «recibido»).
    Después de la intro (o desde el principio) gira despacio con brillo y línea de escaneo; solo mientras se ve (main.js pone .is-live).
    El id debe ser único en la página. Estático con movimiento reducido; el CSS está en la sección «Logo holograma» (crítica). -#}
{% macro logoHolo(id="lh", size="md", intro="") %}
{%- set facetas = [
  ["M35 5 L300 108 L120 143 Z", "#00d8fa"],
  ["M120 143 L300 108 L487 425 L385 598 Z", "#1a94f8"],
  ["M385 598 L487 425 L590 598 L487 780 Z", "#0a40f6"],
  ["M487 425 L670 108 L766 290 L590 598 Z", "#0c8cf7"],
  ["M670 108 L870 108 L766 290 Z", "#00d0f8"],
  ["M870 108 A187 187 0 0 1 940 468 L735 480 L800 357 L850 357 A41 41 0 0 0 850 275 L780 275 Z", "#0b7ef5"],
  ["M800 357 L935 470 L735 480 Z", "#22b6f8"],
  ["M735 480 L940 480 L875 712 Z", "#0757f3"],
  ["M940 480 L1135 830 L875 712 Z", "#1ca2f8"]
] %}
<div class="lholo lholo--{{ size }}{{ ' lholo--' + intro if intro }}" data-lholo aria-hidden="true">
  <svg viewBox="20 0 1130 850" width="{{ 140 if size == 'sm' else (240 if size == 'md' else 420) }}" height="{{ 105 if size == 'sm' else (181 if size == 'md' else 316) }}" focusable="false">
    <defs>
      <clipPath id="{{ id }}-clip">{% for f in facetas %}<path d="{{ f[0] }}"/>{% endfor %}</clipPath>
      <linearGradient id="{{ id }}-scan" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9ef2ff" stop-opacity="0"/><stop offset="0.55" stop-color="#e2fbff" stop-opacity="0.95"/><stop offset="1" stop-color="#9ef2ff" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <g class="lholo__facets">{% for f in facetas %}<path class="lholo__facet" style="--i: {{ loop.index0 }}" d="{{ f[0] }}" fill="{{ f[1] }}"/>{% endfor %}</g>
    <g class="lholo__edges">{% for f in facetas %}<path class="lholo__edge" style="--i: {{ loop.index0 }}" pathLength="1" d="{{ f[0] }}"/>{% endfor %}</g>
    <g clip-path="url(#{{ id }}-clip)"><rect class="lholo__scan" x="0" y="-160" width="1200" height="160" fill="url(#{{ id }}-scan)"/></g>
  </svg>
  {%- if intro == "recv" %}<span class="lholo__ring"></span><span class="lholo__ring lholo__ring--2"></span>{% endif %}
</div>
{% endmacro %}
