{#- Diagrama de arquitectura de Jarvis. data-node / data-edge permiten iluminar partes desde el holograma. -#}
<svg class="arch" viewBox="0 0 1000 470" width="1000" height="470" role="img" aria-labelledby="arch-title arch-desc">
  <title id="arch-title">Arquitectura de Jarvis</title>
  <desc id="arch-desc">Telegram, con voz transcrita por Whisper, conecta con OpenClaw, que orquesta un modelo de OpenAI, los archivos de comportamiento, la memoria persistente, las herramientas controladas y las tareas programadas. Las acciones externas pasan por una aprobación humana. Todo corre en un equipo Lubuntu dedicado.</desc>

  <g data-node="host">
    <rect class="arch__host" x="8" y="8" width="984" height="454" rx="14"/>
    <text class="arch__host-label" x="28" y="446">Equipo Lubuntu dedicado · 24/7 · servicio persistente · backups cifrados · panel de supervisión</text>
  </g>

  <g class="arch__edges">
    <path data-edge="telegram orquestador" d="M232 205 H292"/>
    <path data-edge="voz telegram" d="M132 310 V240"/>
    <path data-edge="orquestador modelo" d="M392 170 V120"/>
    <path data-edge="orquestador comportamiento" d="M392 240 V300"/>
    <path data-edge="orquestador memoria" d="M492 185 L552 85"/>
    <path data-edge="orquestador herramientas" d="M492 205 H552"/>
    <path data-edge="orquestador tareas" d="M492 225 L552 335"/>
    <path data-edge="herramientas gate" d="M752 205 H812"/>
    <path data-edge="tareas gate" d="M752 335 L840 240"/>
    <path data-edge="gate acciones" d="M872 260 V310"/>
  </g>

  <g class="arch__node" data-node="telegram"><rect x="32" y="170" width="200" height="70" rx="8"/><text x="52" y="200">Telegram</text><text class="arch__sub" x="52" y="222">texto y voz</text></g>
  <g class="arch__node" data-node="voz"><rect x="32" y="310" width="200" height="70" rx="8"/><text x="52" y="340">Whisper + TTS</text><text class="arch__sub" x="52" y="362">voz en local</text></g>
  <g class="arch__node arch__node--core" data-node="orquestador"><rect x="292" y="170" width="200" height="70" rx="8"/><text x="312" y="200">OpenClaw</text><text class="arch__sub" x="312" y="222">orquestador</text></g>
  <g class="arch__node" data-node="modelo"><rect x="292" y="50" width="200" height="70" rx="8"/><text x="312" y="80">Modelo de OpenAI</text><text class="arch__sub" x="312" y="102">razonamiento</text></g>
  <g class="arch__node" data-node="comportamiento"><rect x="292" y="300" width="200" height="90" rx="8"/><text x="312" y="330">Comportamiento</text><text class="arch__sub" x="312" y="352">identidad · reglas</text><text class="arch__sub" x="312" y="372">herramientas · memoria</text></g>
  <g class="arch__node" data-node="memoria"><rect x="552" y="50" width="200" height="70" rx="8"/><text x="572" y="80">Memoria persistente</text><text class="arch__sub" x="572" y="102">proyectos y contexto</text></g>
  <g class="arch__node" data-node="herramientas"><rect x="552" y="170" width="200" height="70" rx="8"/><text x="572" y="200">Herramientas</text><text class="arch__sub" x="572" y="222">controladas, bajo riesgo</text></g>
  <g class="arch__node" data-node="tareas"><rect x="552" y="300" width="200" height="70" rx="8"/><text x="572" y="330">Tareas programadas</text><text class="arch__sub" x="572" y="352">radar y avisos</text></g>
  <g class="arch__node arch__node--gate" data-node="gate"><path d="M872 150 L932 205 L872 260 L812 205 Z"/><text x="872" y="201" text-anchor="middle">Aprobación</text><text class="arch__sub" x="872" y="219" text-anchor="middle">de Víctor</text></g>
  <g class="arch__node arch__node--out" data-node="acciones"><rect x="782" y="310" width="180" height="80" rx="8"/><text x="800" y="340">Acciones externas</text><text class="arch__sub" x="800" y="362">correo · publicar</text><text class="arch__sub" x="800" y="380">push · borrar</text></g>
</svg>
