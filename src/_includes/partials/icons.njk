{#- Iconos sencillos de línea (24×24) para las líneas de tiempo. Uso: {% from "partials/icons.njk" import icon %}  {{ icon("alerta") }} -#}
{% macro icon(name) %}
<svg class="ico" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
{%- if name == "alerta" %}
  <path d="M12 3.5 22 20.5H2z"/><path d="M12 10v5M12 17.8v.2"/>
{%- elif name == "copia" %}
  <rect x="4" y="9" width="12" height="11" rx="2"/><path d="M8 9V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-1"/><path d="M10 14.5l2 2 3.5-4"/>
{%- elif name == "llave" %}
  <path d="M14.5 6.5a4 4 0 0 0 4.8 4.8L21 13l-3 3-1.7-1.7a4 4 0 0 1-1.6-4.6L3.5 19.6 4.4 20.5l9.4-9.4a4 4 0 0 1 .7-4.6z"/>
{%- elif name == "decision" %}
  <circle cx="5.5" cy="12" r="2"/><path d="M7.5 12H11l4-5h4M11 12l4 5h4"/><path d="M17 5l2 2-2 2M17 15l2 2-2 2"/>
{%- elif name == "windows" %}
  <rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>
{%- elif name == "juego" %}
  <rect x="2.5" y="7" width="19" height="10" rx="4.5"/><path d="M7 10v4M5 12h4M16 10.5v.1M18 13.5v.1"/>
{%- elif name == "compartir" %}
  <circle class="ic-n ic-n1" cx="6" cy="12" r="2.6"/><circle class="ic-n ic-n2" cx="17.5" cy="6" r="2.6"/><circle class="ic-n ic-n3" cx="17.5" cy="18" r="2.6"/><path d="M8.3 10.8 15.2 7.2M8.3 13.2 15.2 16.8"/>
{%- elif name == "contacto" %}
  <g class="ic-card"><rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="11" r="2.2"/><path d="M5.8 16c.6-1.7 1.8-2.4 3.2-2.4s2.6.7 3.2 2.4M14.5 10h4M14.5 13.5h3"/></g>
{%- elif name == "guias" %}
  <path d="M12 6c-1.6-1.2-4-1.6-8-1.6V18c4 0 6.4.4 8 1.6 1.6-1.2 4-1.6 8-1.6V4.4C16 4.4 13.6 4.8 12 6z"/><path class="ic-page" d="M12 6v13.6"/>
{%- elif name == "escudo" %}
  <path d="M12 3 20 6v6c0 4.5-3.2 7.6-8 9-4.8-1.4-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5L15.5 10"/>
{%- endif %}
</svg>
{% endmacro %}
